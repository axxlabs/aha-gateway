# Aha! gateway. Build from the repo root: podman build -f deploy/Containerfile -t aha-gateway .
FROM docker.io/library/python:3.12-slim AS build
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
WORKDIR /src
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY aha_gateway ./aha_gateway
RUN uv build --wheel -o /dist && uv pip install --system --no-cache /dist/*.whl

FROM docker.io/library/python:3.12-slim
COPY --from=build /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
RUN useradd --system --uid 10001 aha && mkdir -p /keys && chown aha /keys
USER aha
ENV AHA_GW_HOST=0.0.0.0 AHA_GW_PORT=8700 PYTHONUNBUFFERED=1
EXPOSE 8700
ENTRYPOINT ["python", "-m", "aha_gateway"]
