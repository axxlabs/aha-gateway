# SHA gateway. Build from the repo root: podman build -f deploy/Containerfile -t aha-gateway .
# Images pinned by multi-arch digest (SPEC §9.2): python:3.12-slim, uv:latest. Update deliberately.
FROM docker.io/library/python@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b AS build
COPY --from=ghcr.io/astral-sh/uv@sha256:d3b601f0c7b118bc1753febf7c41cc80981df678445e0254284eecf84db79a7d /uv /usr/local/bin/uv
WORKDIR /src
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY aha_gateway ./aha_gateway
RUN uv build --wheel -o /dist && uv pip install --system --no-cache /dist/*.whl

FROM docker.io/library/python@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
COPY --from=build /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
RUN useradd --system --uid 10001 aha && mkdir -p /keys && chown aha /keys
USER aha
ENV AHA_GW_HOST=0.0.0.0 AHA_GW_PORT=8700 PYTHONUNBUFFERED=1
ARG AHA_BUILD=unknown
ENV AHA_BUILD=$AHA_BUILD
EXPOSE 8700
ENTRYPOINT ["python", "-m", "aha_gateway"]
